<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext is allowed so the app can talk to a self-hosted dev server over HTTP.
     Serve the API over HTTPS in production and remove this file. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
