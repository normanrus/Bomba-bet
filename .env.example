# Скопируйте в .env и заполните своими значениями.
# .env НЕ коммитится в git.

POSTGRES_USER=bombabet
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=bombabet

# Минимум 32 случайных символа. Сгенерировать: openssl rand -hex 32
JWT_SECRET=change-me-at-least-32-random-characters

# Первый администратор. Оставьте ADMIN_PASSWORD пустым, чтобы сервер
# сгенерировал пароль и напечатал его ОДИН раз в логе (docker compose logs api).
ADMIN_USERNAME=owner
ADMIN_PASSWORD=

API_PORT=4000
ADMIN_PORT=8080

# Загрузить демо-матчи и игроков при первом запуске.
SEED_DEMO_DATA=false
