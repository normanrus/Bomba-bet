# ---- Server ----
PORT=4000
# Interface to bind. 0.0.0.0 is required on Render/Docker. Only narrow this if
# you deliberately want a loopback-only server.
HOST=0.0.0.0
NODE_ENV=development
# Comma separated list of allowed origins for the admin panel. * allows all.
CORS_ORIGIN=http://localhost:5173,http://localhost:8081

# ---- Database ----
DATABASE_URL=postgres://bombabet:bombabet_dev_pass@localhost:5432/bombabet
PGSSLMODE=disable
# Startup retry window for managed databases that are still booting.
DB_READY_ATTEMPTS=30
DB_READY_DELAY_MS=2000

# ---- Auth ----
# CHANGE THIS. Must be a long random string in production.
JWT_SECRET=dev_only_change_me_please_32_chars_min
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL_DAYS=30

# ---- Bootstrap admin ----
# Used once by `npm run seed`. Password must be >= 12 chars.
ADMIN_USERNAME=owner
ADMIN_PASSWORD=
# If ADMIN_PASSWORD is empty a strong random password is generated and printed once.

# ---- Economy defaults ----
SIGNUP_BONUS=1000
